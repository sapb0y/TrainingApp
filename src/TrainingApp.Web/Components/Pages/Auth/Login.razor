@page "/login"
@using Microsoft.AspNetCore.Identity
@using TrainingApp.Core.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject NavigationManager Navigation

<PageTitle>Login — FitSpiralS</PageTitle>

<div class="fs-auth-page">
    <div class="fs-auth-card">
        <h1>Welcome back.</h1>
        <p class="fs-auth-subtitle">Let's get to work.</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="fs-alert-error">@_error</div>
        }

        <EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post">
            <DataAnnotationsValidator />

            <div class="fs-form-group">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="Input!.Email" type="email" placeholder="you@example.com" />
            </div>

            <div class="fs-form-group">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="Input!.Password" type="password" placeholder="••••••••" />
            </div>

            <button type="submit" class="fs-btn-submit">Sign In</button>
        </EditForm>

        <p class="fs-auth-footer">
            Don't have an account? <a href="/register">Register</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel? Input { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input!.Email, Input.Password, isPersistent: true, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            var user = await UserManager.FindByEmailAsync(Input!.Email);
            var isAdmin = user is not null && await UserManager.IsInRoleAsync(user, "Admin");
            var redirectUrl = isAdmin ? "/admin" : "/dashboard";
            Navigation.NavigateTo(redirectUrl, forceLoad: true);
        }
        else
        {
            _error = "Invalid email or password.";
        }
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
