@page "/register"
@using Microsoft.AspNetCore.Identity
@using TrainingApp.Core.Entities
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject NavigationManager Navigation

<PageTitle>Register — FitSpiralS</PageTitle>

<div class="fs-auth-page">
    <div class="fs-auth-card">
        <h1>Join the spiral.</h1>
        <p class="fs-auth-subtitle">30 days free. No credit card. Just you and the iron.</p>

        @if (_errors.Count > 0)
        {
            <div class="fs-alert-error">
                @foreach (var err in _errors)
                {
                    <div>@err</div>
                }
            </div>
        }

        <EditForm Model="Input" FormName="register" OnValidSubmit="RegisterAsync" method="post">
            <DataAnnotationsValidator />

            <div class="fs-form-group">
                <label for="displayname">Display Name</label>
                <InputText id="displayname" @bind-Value="Input!.DisplayName" placeholder="Your name" />
            </div>

            <div class="fs-form-group">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="Input!.Email" type="email" placeholder="you@example.com" />
            </div>

            <div class="fs-form-group">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="Input!.Password" type="password" placeholder="••••••••" />
            </div>

            <div class="fs-form-group">
                <label for="confirm">Confirm Password</label>
                <InputText id="confirm" @bind-Value="Input!.ConfirmPassword" type="password" placeholder="••••••••" />
            </div>

            <button type="submit" class="fs-btn-submit">Create Account</button>
        </EditForm>

        <p class="fs-auth-footer">
            Already have an account? <a href="/login">Sign in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterModel? Input { get; set; }

    private List<string> _errors = [];

    protected override void OnInitialized() => Input ??= new();

    private async Task RegisterAsync()
    {
        _errors.Clear();

        if (Input!.Password != Input.ConfirmPassword)
        {
            _errors.Add("Passwords do not match.");
            return;
        }

        var user = new User
        {
            UserName = Input.Email,
            Email = Input.Email,
            DisplayName = Input.DisplayName,
            EmailConfirmed = true
        };

        var result = await UserManager.CreateAsync(user, Input.Password);
        if (result.Succeeded)
        {
            await UserManager.AddToRoleAsync(user, "Athlete");
            await SignInManager.SignInAsync(user, isPersistent: true);
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else
        {
            _errors.AddRange(result.Errors.Select(e => e.Description));
        }
    }

    private sealed class RegisterModel
    {
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
