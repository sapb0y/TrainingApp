@page "/dashboard"
@using TrainingApp.Core.Interfaces
@using TrainingApp.Core.Services
@attribute [Authorize]
@inject IUserDashboardService DashboardService
@inject ICurrentUserService CurrentUser

<PageTitle>Dashboard — FitSpiralS</PageTitle>

<div class="fs-dashboard">
    <div class="fs-dashboard-inner">
        <h1 class="fs-animate">Your Dashboard</h1>

        @if (_data is null)
        {
            <p class="fs-dashboard-loading fs-animate">Loading your data...</p>
        }
        else
        {
            var summary = _data.Summary;
            <div class="fs-dash-grid fs-animate fs-delay-1">
                @* ── Strength ── *@
                <div class="fs-dash-card">
                    <h3>Strength</h3>
                    @if (summary.Strength.ExercisesTracked > 0)
                    {
                        <div class="fs-dash-stat">
                            <span class="fs-dash-value">@summary.Strength.ExercisesTracked</span>
                            <span class="fs-dash-label">Exercises tracked</span>
                        </div>
                        @if (summary.Strength.TopE1rm.HasValue)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value">@summary.Strength.TopE1rm.Value.ToString("N1") kg</span>
                                <span class="fs-dash-label">Top e1RM — @summary.Strength.TopExercise</span>
                            </div>
                        }
                        @if (summary.Strength.E1rmChangePct30d.HasValue)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value fs-dash-change @(summary.Strength.E1rmChangePct30d.Value >= 0 ? "positive" : "negative")">
                                    @(summary.Strength.E1rmChangePct30d.Value >= 0 ? "+" : "")@summary.Strength.E1rmChangePct30d.Value.ToString("N1")%
                                </span>
                                <span class="fs-dash-label">30-day change</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="fs-dash-empty">No strength data yet. Complete a workout to get started.</p>
                    }
                </div>

                @* ── Body Weight ── *@
                <div class="fs-dash-card">
                    <h3>Body Weight</h3>
                    @if (summary.BodyWeight.CurrentKg.HasValue)
                    {
                        <div class="fs-dash-stat">
                            <span class="fs-dash-value">@summary.BodyWeight.CurrentKg.Value.ToString("N1") kg</span>
                            <span class="fs-dash-label">Current</span>
                        </div>
                        @if (summary.BodyWeight.MovingAvg7d.HasValue)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value">@summary.BodyWeight.MovingAvg7d.Value.ToString("N1") kg</span>
                                <span class="fs-dash-label">7-day average</span>
                            </div>
                        }
                        @if (summary.BodyWeight.Trend is not null)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value">@summary.BodyWeight.Trend</span>
                                <span class="fs-dash-label">Trend</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="fs-dash-empty">No weight data logged yet.</p>
                    }
                </div>

                @* ── Activity ── *@
                <div class="fs-dash-card">
                    <h3>Activity (30 days)</h3>
                    <div class="fs-dash-stat">
                        <span class="fs-dash-value">@_data.ActiveDays</span>
                        <span class="fs-dash-label">Active days</span>
                    </div>
                    @if (summary.Cardio.SessionsLast30d > 0)
                    {
                        <div class="fs-dash-stat">
                            <span class="fs-dash-value">@summary.Cardio.SessionsLast30d</span>
                            <span class="fs-dash-label">Cardio sessions</span>
                        </div>
                        <div class="fs-dash-stat">
                            <span class="fs-dash-value">@summary.Cardio.MinutesLast30d min</span>
                            <span class="fs-dash-label">Cardio time</span>
                        </div>
                    }
                </div>

                @* ── Volume (7 days) ── *@
                <div class="fs-dash-card">
                    <h3>Volume (7 days)</h3>
                    @if (summary.Volume.TotalSetsLast7d > 0)
                    {
                        <div class="fs-dash-stat">
                            <span class="fs-dash-value">@summary.Volume.TotalSetsLast7d</span>
                            <span class="fs-dash-label">Total sets</span>
                        </div>
                        @if (summary.Volume.TotalVolumeLast7d.HasValue)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value">@summary.Volume.TotalVolumeLast7d.Value.ToString("N0") kg</span>
                                <span class="fs-dash-label">Total volume</span>
                            </div>
                        }
                        @if (summary.Volume.VolumeChangePctVsPrev7d.HasValue)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value fs-dash-change @(summary.Volume.VolumeChangePctVsPrev7d.Value >= 0 ? "positive" : "negative")">
                                    @(summary.Volume.VolumeChangePctVsPrev7d.Value >= 0 ? "+" : "")@summary.Volume.VolumeChangePctVsPrev7d.Value.ToString("N1")%
                                </span>
                                <span class="fs-dash-label">vs. previous week</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="fs-dash-empty">No volume data this week.</p>
                    }
                </div>

                @* ── Fatigue / Readiness ── *@
                <div class="fs-dash-card">
                    <h3>Readiness</h3>
                    @if (summary.Fatigue.ReadinessCategory is not null)
                    {
                        <div class="fs-dash-stat">
                            <span class="fs-dash-value fs-readiness-@(summary.Fatigue.ReadinessCategory.ToLowerInvariant().Replace(" ", "-"))">
                                @summary.Fatigue.ReadinessCategory
                            </span>
                            <span class="fs-dash-label">Current readiness</span>
                        </div>
                        @if (summary.Fatigue.Tsb.HasValue)
                        {
                            <div class="fs-dash-stat">
                                <span class="fs-dash-value">@summary.Fatigue.Tsb.Value.ToString("N1")</span>
                                <span class="fs-dash-label">TSB (form)</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="fs-dash-empty">Not enough training data for readiness estimates.</p>
                    }
                </div>

                @* ── Recent PRs ── *@
                <div class="fs-dash-card">
                    <h3>Recent PRs</h3>
                    @if (_data.RecentPRs.Count > 0)
                    {
                        <ul class="fs-dash-pr-list">
                            @foreach (var pr in _data.RecentPRs)
                            {
                                <li>
                                    <span class="fs-dash-pr-exercise">@pr.ExerciseName</span>
                                    <span class="fs-dash-pr-value">@pr.BestE1rm.ToString("N1") kg</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="fs-dash-empty">No recent personal records.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private UserDashboardData? _data;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.IsAuthenticated)
        {
            _data = await DashboardService.GetDashboardAsync(CurrentUser.UserId);
        }
    }
}
