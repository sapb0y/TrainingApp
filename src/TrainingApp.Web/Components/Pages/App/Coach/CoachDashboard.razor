@page "/app/coach"
@layout AppLayout
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using TrainingApp.Core.Entities
@using TrainingApp.Core.Interfaces
@using TrainingApp.Core.Services
@using TrainingApp.Infrastructure.Data
@attribute [Authorize]
@inject ICoachAthleteService CoachService
@inject ICoachAlertAggregatorService AlertService
@inject ICurrentUserService CurrentUser
@inject TrainingAppDbContext Db
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Coach Dashboard — FitSpiralS</PageTitle>

<TierGate RequiredTier="SubscriptionTier.Coach">

<PageHeader Title="Coach Dashboard" Subtitle="Your athletes at a glance">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="CreateInvite">Invite Athlete</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ── Summary Cards ── *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" sm="3">
            <StatCard Label="Athletes" Value="@_roster.Count.ToString()" Icon="@Icons.Material.Filled.Group" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <StatCard Label="Need Attention" Value="@_needingAttention.ToString()" Icon="@Icons.Material.Filled.Warning"
                      Subtitle="@(_needingAttention > 0 ? "alerts or warnings" : "all clear")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <StatCard Label="Total Alerts" Value="@_alerts.Count.ToString()" Icon="@Icons.Material.Filled.NotificationsActive" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <StatCard Label="Pending Invites" Value="@_pendingInvites.ToString()" Icon="@Icons.Material.Filled.HourglassEmpty" />
        </MudItem>
    </MudGrid>

    @* ── Alerts ── *@
    @if (_alerts.Any())
    {
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid #1F1F2E;">
            <MudText Typo="Typo.h6" Class="mb-2">Alerts</MudText>
            @foreach (var a in _alerts.Take(10))
            {
                <MudAlert Severity="@AlertSeverity(a.Severity)" Dense="true" Class="mb-1" NoIcon="false">
                    <div class="d-flex align-center justify-space-between" style="width:100%;">
                        <span><b>@a.AthleteName</b> — @a.Message</span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                                   OnClick="() => AlertAction(a)">@AlertActionLabel(a.Category)</MudButton>
                    </div>
                </MudAlert>
            }
            @if (_alerts.Count > 10)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">+ @(_alerts.Count - 10) more alerts</MudText>
            }
        </MudPaper>
    }

    @* ── Roster Table ── *@
    @if (_roster.Any())
    {
        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #1F1F2E;">
            <MudText Typo="Typo.h6" Class="mb-2">Athlete Roster</MudText>
            <MudSimpleTable Dense="true" Hover="true" Style="background: transparent;">
                <thead>
                    <tr>
                        <th>Athlete</th>
                        <th>TSB</th>
                        <th>Trend</th>
                        <th>Readiness</th>
                        <th>Alerts</th>
                        <th>7d Risk</th>
                        <th>Unreviewed</th>
                        <th>Last Workout</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _roster)
                    {
                        <tr style="@(r.AlertCount > 0 ? "border-left: 3px solid #EF4444;" : "")">
                            <td><b>@r.Name</b></td>
                            <td>
                                @if (r.Tsb.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@TsbColor(r.Tsb.Value)">@r.Tsb.Value.ToString("F0")</MudChip>
                                }
                                else { <span>—</span> }
                            </td>
                            <td>
                                @if (r.Trend == "Improving")
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" />
                                }
                                else if (r.Trend == "Worsening")
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Color="Color.Default" Size="Size.Small" />
                                }
                            </td>
                            <td>@(r.Readiness ?? "—")</td>
                            <td>
                                @if (r.AlertCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@r.AlertCount</MudChip>
                                }
                                else { <span>0</span> }
                            </td>
                            <td>
                                @{ var (riskLabel, riskColor) = RiskDisplay(r.Risk); }
                                <MudChip T="string" Size="Size.Small" Color="@riskColor">@riskLabel</MudChip>
                            </td>
                            <td>
                                @if (r.UnreviewedCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@r.UnreviewedCount</MudChip>
                                }
                                else { <span>0</span> }
                            </td>
                            <td>@(r.LastWorkout?.ToString("MMM d") ?? "—")</td>
                            <td>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           OnClick="() => GoToAthlete(r.AthleteId)">View</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
    else
    {
        <EmptyState Message="No athletes yet. Invite your first athlete!" Icon="@Icons.Material.Filled.GroupOff"
                    ActionText="Invite Athlete" OnAction="CreateInvite" />
    }

    @* ── Pending Invites ── *@
    @if (_invites.Any())
    {
        <MudPaper Elevation="0" Class="pa-4 mt-4" Style="border: 1px solid #1F1F2E;">
            <MudText Typo="Typo.h6" Class="mb-2">Pending Invites</MudText>
            @foreach (var inv in _invites)
            {
                <MudCard Elevation="0" Class="mb-2 pa-3" Style="border: 1px solid #1F1F2E;">
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.body1">Code: <b>@inv.InviteCode</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Created @inv.CreatedAt.LocalDateTime.ToString("MMM d")
                                @if (inv.ExpiresAt.HasValue)
                                {
                                    <text> · Expires @inv.ExpiresAt.Value.LocalDateTime.ToString("MMM d")</text>
                                }
                            </MudText>
                        </div>
                    </div>
                </MudCard>
            }
        </MudPaper>
    }
}

</TierGate>

@code {
    private bool _loading = true;
    private List<RosterItem> _roster = [];
    private List<CoachAlertEngine.CoachAlert> _alerts = [];
    private List<CoachAthlete> _invites = [];
    private int _needingAttention;
    private int _pendingInvites;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsCoach) { _loading = false; return; }

        var coachId = CurrentUser.UserId;
        var athletes = await CoachService.GetAthletesAsync(coachId, default);
        _alerts = await AlertService.GetAlertsForAllAthletesAsync(coachId, default);

        var alertsByAthlete = _alerts.GroupBy(a => a.AthleteId).ToDictionary(g => g.Key, g => g.ToList());
        var athleteIds = athletes.Where(r => r.AthleteId.HasValue).Select(r => r.AthleteId!.Value).ToList();

        _invites = athletes.Where(r => r.Status == CoachAthleteStatus.Pending).ToList();
        _pendingInvites = _invites.Count;

        var latestMetrics = await Db.DailyMetrics.AsNoTracking()
            .Where(m => athleteIds.Contains(m.UserId))
            .GroupBy(m => m.UserId)
            .Select(g => g.OrderByDescending(m => m.Date).First())
            .ToDictionaryAsync(m => m.UserId);

        var lastWorkouts = await Db.Workouts.AsNoTracking()
            .Where(w => athleteIds.Contains(w.UserId) && w.Status == WorkoutStatus.Completed)
            .GroupBy(w => w.UserId)
            .Select(g => new { UserId = g.Key, Last = g.Max(w => w.CompletedAt) })
            .ToDictionaryAsync(x => x.UserId, x => x.Last);

        var unreviewedCounts = await Db.Workouts.AsNoTracking()
            .Where(w => athleteIds.Contains(w.UserId) && w.Status == WorkoutStatus.Completed && w.ReviewedAt == null)
            .GroupBy(w => w.UserId)
            .Select(g => new { UserId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.UserId, x => x.Count);

        // Load 7-day metric history for trend + risk
        var sevenDaysAgo = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-7));
        var recentMetrics = await Db.DailyMetrics.AsNoTracking()
            .Where(m => athleteIds.Contains(m.UserId) && m.Date >= sevenDaysAgo)
            .OrderBy(m => m.Date)
            .ToListAsync();
        var metricsByAthlete = recentMetrics.GroupBy(m => m.UserId).ToDictionary(g => g.Key, g => g.ToList());

        foreach (var rel in athletes.Where(r => r.AthleteId.HasValue && r.Status == CoachAthleteStatus.Active))
        {
            var aid = rel.AthleteId!.Value;
            latestMetrics.TryGetValue(aid, out var metrics);
            lastWorkouts.TryGetValue(aid, out var lastW);

            string? readiness = null;
            if (metrics?.ReadinessScore is not null)
            {
                readiness = metrics.ReadinessScore.Value switch
                {
                    >= 8m => "Excellent", >= 6m => "Good", >= 4m => "Moderate", >= 3m => "Poor", _ => "Very Poor"
                };
            }

            var alertCount = alertsByAthlete.TryGetValue(aid, out var aa) ? aa.Count : 0;
            var unreviewed = unreviewedCounts.GetValueOrDefault(aid, 0);

            // Trend: compare current alert count to 7-day-ago alert count proxy via TSB direction
            var history = metricsByAthlete.GetValueOrDefault(aid, []);
            var trend = ComputeTrend(alertCount, history);
            var risk = ComputeRisk(history, metrics?.Tsb);

            _roster.Add(new RosterItem(aid, rel.Athlete?.DisplayName ?? "Unknown",
                metrics?.Tsb, readiness, alertCount, unreviewed, lastW?.LocalDateTime, trend, risk));
        }

        _needingAttention = alertsByAthlete.Count(kv => kv.Value.Any(a => a.Severity is "Alert" or "Warning"));
        _loading = false;
    }

    private async Task CreateInvite()
    {
        try
        {
            var rel = await CoachService.CreateInviteAsync(CurrentUser.UserId, default);
            _invites.Add(rel);
            _pendingInvites++;
            Snackbar.Add($"Invite created: {rel.InviteCode}", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void GoToAthlete(Guid id) => Nav.NavigateTo($"/app/coach/athlete/{id}");

    // ── R6: Alert Actions ──
    private void AlertAction(CoachAlertEngine.CoachAlert alert)
    {
        var id = alert.AthleteId;
        var url = alert.Category switch
        {
            CoachAlertEngine.CoachAlertCategory.FatigueRisk or CoachAlertEngine.CoachAlertCategory.OverreachingRisk
                => $"/app/coach/athlete/{id}/programs",
            CoachAlertEngine.CoachAlertCategory.MissedSessions
                => $"/app/coach/athlete/{id}/messages",
            _ => $"/app/coach/athlete/{id}"
        };
        Nav.NavigateTo(url);
    }

    private static string AlertActionLabel(CoachAlertEngine.CoachAlertCategory cat) => cat switch
    {
        CoachAlertEngine.CoachAlertCategory.FatigueRisk or CoachAlertEngine.CoachAlertCategory.OverreachingRisk => "View Programs",
        CoachAlertEngine.CoachAlertCategory.MissedSessions => "Send Message",
        CoachAlertEngine.CoachAlertCategory.RPEDrift => "Review Workouts",
        _ => "View Athlete"
    };

    // ── R4: Trend ──
    private static string ComputeTrend(int currentAlertCount, List<DailyMetrics> history)
    {
        if (history.Count < 2) return "Stable";
        // Use TSB slope as proxy for improving/worsening
        var tsbValues = history.Select(m => m.Tsb).ToList();
        var slope = TsbSlope(tsbValues);
        if (slope > 0.5m) return "Improving";
        if (slope < -0.5m) return "Worsening";
        return "Stable";
    }

    // ── R5: 7-day Risk ──
    private static string ComputeRisk(List<DailyMetrics> history, decimal? currentTsb)
    {
        if (history.Count < 2) return "Unknown";
        var slope = TsbSlope(history.Select(m => m.Tsb).ToList());
        var tsb = currentTsb ?? history.Last().Tsb;
        if (slope < 0 && tsb < 0) return "High";
        if (slope < 0 && tsb >= 0) return "Watch";
        return "Low";
    }

    private static decimal TsbSlope(List<decimal> values)
    {
        if (values.Count < 2) return 0;
        // Simple linear regression slope
        var n = values.Count;
        decimal sumX = 0, sumY = 0, sumXY = 0, sumX2 = 0;
        for (int i = 0; i < n; i++)
        {
            sumX += i; sumY += values[i]; sumXY += i * values[i]; sumX2 += i * i;
        }
        var denom = n * sumX2 - sumX * sumX;
        return denom == 0 ? 0 : (n * sumXY - sumX * sumY) / denom;
    }

    private static (string Label, Color Color) RiskDisplay(string risk) => risk switch
    {
        "High" => ("High Risk", Color.Error),
        "Watch" => ("Watch", Color.Warning),
        "Low" => ("Low Risk", Color.Success),
        _ => ("Unknown", Color.Default)
    };

    private static Severity AlertSeverity(string s) => s switch
    {
        "Alert" => Severity.Error,
        "Warning" => Severity.Warning,
        _ => Severity.Info
    };

    private static Color TsbColor(decimal tsb)
    {
        if (tsb < -10) return Color.Error;
        if (tsb < 0) return Color.Warning;
        return Color.Success;
    }

    private record RosterItem(Guid AthleteId, string Name, decimal? Tsb, string? Readiness,
        int AlertCount, int UnreviewedCount, DateTime? LastWorkout, string Trend, string Risk);
}
