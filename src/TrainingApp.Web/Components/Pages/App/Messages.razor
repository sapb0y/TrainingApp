@page "/app/messages"
@layout AppLayout
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using TrainingApp.Core.Entities
@using TrainingApp.Core.Interfaces
@using TrainingApp.Infrastructure.Data
@attribute [Authorize]
@inject ICurrentUserService CurrentUser
@inject TrainingAppDbContext Db
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Messages — FitSpiralS</PageTitle>

<PageHeader Title="Messages" Subtitle="Messages from your coach" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_coachRelationship is null)
{
    <EmptyState Message="No coach assigned. Ask your coach for an invite code!"
                Icon="@Icons.Material.Filled.School" />
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Coach: <b>@_coachName</b>
    </MudText>

    <MudPaper Elevation="0" Class="pa-4" id="message-container" Style="border: 1px solid #1F1F2E; max-height: 500px; overflow-y: auto;">
        @if (!_messages.Any())
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">No messages yet.</MudText>
        }
        else
        {
            @foreach (var msg in _messages)
            {
                var isMe = msg.SenderId == CurrentUser.UserId;
                <div class="d-flex @(isMe ? "justify-end" : "justify-start") mb-2">
                    <MudPaper Elevation="0" Class="pa-3" Style="@($"max-width:70%;border-radius:12px;background:{(isMe ? "#2D1B69" : "#1F1F2E")};")">
                        <MudText Typo="Typo.body2">@msg.Content</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="@(isMe ? Align.Right : Align.Left)">
                            @msg.CreatedAt.LocalDateTime.ToString("MMM d, h:mm tt")
                        </MudText>
                    </MudPaper>
                </div>
            }
        }
    </MudPaper>

    <div class="d-flex gap-2 mt-3">
        <MudTextField T="string" @bind-Value="_newMessage" Label="Type a message..." Variant="Variant.Outlined"
                      Immediate="true" OnKeyDown="OnKeyDown" Style="flex: 1;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendMessage"
                   Disabled="@(string.IsNullOrWhiteSpace(_newMessage) || _sending)"
                   StartIcon="@Icons.Material.Filled.Send">Send</MudButton>
    </div>
}

@code {
    private bool _loading = true;
    private CoachAthlete? _coachRelationship;
    private string _coachName = "";
    private List<CoachMessage> _messages = [];
    private string _newMessage = "";
    private bool _sending;
    private bool _shouldScroll;

    protected override async Task OnInitializedAsync()
    {
        _coachRelationship = await Db.CoachAthletes.AsNoTracking()
            .Include(ca => ca.Coach)
            .Where(ca => ca.AthleteId == CurrentUser.UserId && ca.Status == CoachAthleteStatus.Active)
            .FirstOrDefaultAsync();

        if (_coachRelationship is null) { _loading = false; return; }

        _coachName = _coachRelationship.Coach?.DisplayName ?? "Unknown";

        _messages = await Db.CoachMessages.AsNoTracking()
            .Where(m => m.CoachAthleteId == _coachRelationship.Id)
            .OrderBy(m => m.CreatedAt)
            .ToListAsync();

        _shouldScroll = true;

        // Mark unread as read
        var unread = await Db.CoachMessages
            .Where(m => m.CoachAthleteId == _coachRelationship.Id && m.SenderId != CurrentUser.UserId && m.ReadAt == null)
            .ToListAsync();
        foreach (var m in unread) m.ReadAt = DateTimeOffset.UtcNow;
        if (unread.Count > 0) await Db.SaveChangesAsync();

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScroll)
        {
            _shouldScroll = false;
            await JS.InvokeVoidAsync("scrollToBottom", "message-container");
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_newMessage) || _coachRelationship is null) return;
        _sending = true;

        try
        {
            var msg = new CoachMessage
            {
                Id = Guid.NewGuid(),
                CoachAthleteId = _coachRelationship.Id,
                SenderId = CurrentUser.UserId,
                Content = _newMessage.Trim(),
                CreatedAt = DateTimeOffset.UtcNow
            };
            Db.CoachMessages.Add(msg);
            await Db.SaveChangesAsync();
            _messages.Add(msg);
            _newMessage = "";
            _shouldScroll = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }

        _sending = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }
}
