@* SSR-safe feature card *@

<MudCard Elevation="0" Style="border: 1px solid #E0E0E0;">
    <MudCardContent Class="text-center pa-6">
        <MudIcon Icon="@Icon" Color="Color.Primary" Style="font-size: 2.5rem;" />
        <MudText Typo="Typo.h6" Class="mt-3">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@Description</MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Star;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
}
