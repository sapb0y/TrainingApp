<div class="fs-feature-card fs-animate fs-delay-@Delay">
    <span class="fs-card-emoji">@Emoji</span>
    <h3>@Title</h3>
    <p>@Description</p>
</div>

@code {
    [Parameter] public string Emoji { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public int Delay { get; set; } = 1;
}
