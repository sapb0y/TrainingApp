<MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Style="min-height: 200px;" Elevation="0">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
    <MudText Typo="Typo.h6" Align="Align.Center">@Message</MudText>
    @if (!string.IsNullOrEmpty(ActionText))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                   OnClick="OnAction">@ActionText</MudButton>
    }
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public required string Message { get; set; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
