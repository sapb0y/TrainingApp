@rendermode InteractiveServer
@using TrainingApp.Core.Interfaces
@inject IEmailService EmailService

<button class="@CssClass" @onclick="Open">@Text</button>

@if (_open)
{
    <div class="fs-beta-overlay" @onclick="Close">
        <div class="fs-beta-modal" @onclick:stopPropagation="true">
            @if (_submitted)
            {
                <h2>Application sent!</h2>
                <p class="fs-beta-subtitle">Thanks, @_name. We'll be in touch soon.</p>
                <div class="fs-beta-actions">
                    <button class="fs-btn-primary" @onclick="Close">Close</button>
                </div>
            }
            else
            {
                <h2>Apply for the Beta</h2>
                <p class="fs-beta-subtitle">Tell us about yourself. We'll be in touch.</p>

                <div class="fs-form-group">
                    <label>Name *</label>
                    <input @bind="_name" placeholder="Your name" />
                </div>

                <div class="fs-form-group">
                    <label>Email *</label>
                    <input type="email" @bind="_email" placeholder="you@example.com" />
                </div>

                <div class="fs-form-group">
                    <label>Tier Interest</label>
                    <select @bind="_tier">
                        <option value="Athlete">Athlete</option>
                        <option value="Competitor">Competitor</option>
                        <option value="Coach">Coach</option>
                    </select>
                </div>

                <div class="fs-form-group">
                    <label>About you & why you're interested</label>
                    <textarea @bind="_bio" rows="4" placeholder="What do you lift? How do you train? What are you tired of?"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="fs-beta-error">@_error</p>
                }

                <div class="fs-beta-actions">
                    <button class="fs-btn-secondary" @onclick="Close">Cancel</button>
                    <button class="fs-btn-primary" @onclick="Submit" disabled="@_sending">
                        @(_sending ? "Sending..." : "Send Application")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string CssClass { get; set; } = "fs-btn-primary fs-pulse-glow";
    [Parameter] public string Text { get; set; } = "Apply for the Beta";
    [Parameter] public string? PreselectedTier { get; set; }

    private bool _open;
    private bool _sending;
    private bool _submitted;
    private string _name = "";
    private string _email = "";
    private string _tier = "Athlete";
    private string _bio = "";
    private string? _error;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(PreselectedTier))
            _tier = PreselectedTier;
    }

    private void Open()
    {
        _open = true;
        _submitted = false;
    }

    private void Close()
    {
        _open = false;
        _error = null;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_email))
        {
            _error = "Name and email are required.";
            return;
        }

        _sending = true;
        _error = null;

        try
        {
            await EmailService.SendBetaApplicationAsync(_name, _email, _tier, _bio);
            _submitted = true;
        }
        catch
        {
            _error = "Something went wrong. Please try again.";
        }
        finally
        {
            _sending = false;
        }
    }
}
