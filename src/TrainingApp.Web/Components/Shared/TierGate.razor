@using TrainingApp.Core.Entities
@using TrainingApp.Core.Interfaces
@inject ICurrentUserService CurrentUser

@if (CurrentUser.Tier >= RequiredTier)
{
    @ChildContent
}
else
{
    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Style="min-height: 300px;" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">@RequiredTier Tier Required</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-4">
            Upgrade to @RequiredTier to unlock this feature.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/app/subscription">
            View Plans
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public SubscriptionTier RequiredTier { get; set; } = SubscriptionTier.Competitor;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
