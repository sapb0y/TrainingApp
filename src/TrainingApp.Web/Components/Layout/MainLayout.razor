@inherits LayoutComponentBase

<nav class="fs-nav">
    <a href="/" class="fs-nav-brand">FitSpiralS</a>

    <input type="checkbox" id="fs-menu-toggle" class="fs-hamburger-toggle" />
    <label for="fs-menu-toggle" class="fs-hamburger" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <label for="fs-menu-toggle" class="fs-nav-overlay"></label>

    <div class="fs-nav-links">
        <a href="/pricing">Pricing</a>
        <AuthorizeView>
            <Authorized>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <a href="/admin">Dashboard</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/dashboard">Dashboard</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="/logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login">Login</a>
                <a href="/register" class="fs-btn-nav">Start Free</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@Body

<footer class="fs-footer">
    <div class="fs-footer-inner">
        <div>
            <p class="fs-footer-brand">FitSpiralS</p>
            <p class="fs-footer-desc">Built on science, for lifters who care.</p>
        </div>
        <div>
            <h4>Product</h4>
            <ul class="fs-footer-links">
                <li><a href="/pricing">Pricing</a></li>
                <li><a href="/register">Free Trial</a></li>
                <li><a href="/login">Sign In</a></li>
            </ul>
        </div>
        <div>
            <h4>Legal</h4>
            <ul class="fs-footer-links">
                <li><a href="mailto:support@fitspirals.com">Contact</a></li>
            </ul>
        </div>
    </div>
    <div class="fs-footer-bottom">
        &copy; @DateTime.UtcNow.Year FitSpiralS. All rights reserved.
    </div>
</footer>
